local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type LibraryType = {
	Loaded: boolean,
	Directory: any,
	Network: any,
	Signal: any,
	Variables: { [string]: any },
	LocalPlayer: Player?,
	[string]: any,
}

local signals: { [string]: BindableEvent } = {}

local Signal = {}

function Signal.Connect(name: string, callback: (...any) -> ()): RBXScriptConnection
	local bindable = signals[name]
	if not bindable then
		bindable = Instance.new("BindableEvent")
		bindable.Name = name
		signals[name] = bindable
	end
	return bindable.Event:Connect(callback)
end

function Signal.Fire(name: string, ...: any)
	local bindable = signals[name]
	if bindable then
		bindable:Fire(...)
	end
end

local Library: any = {
	Loaded = false,
	Directory = {},
	Network = require(script.Parent:WaitForChild("Network")),
	Signal = Signal,
	Variables = {},
	LocalPlayer = if RunService:IsClient() then Players.LocalPlayer else nil,
}

local isServer = RunService:IsServer()

-- Carregamento dinamico recursivo das tabelas de dados de ReplicatedStorage/Directory
local directoryFolder = ReplicatedStorage:FindFirstChild("Directory") or ReplicatedStorage:WaitForChild("__DIRECTORY", 5) or ReplicatedStorage:WaitForChild("Directory", 5)
if directoryFolder then
	local function LoadModulesRecursively(folder: Instance, targetTable: { [string]: any })
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("ModuleScript") then
				local success, data = pcall(require, child)
				if success and type(data) == "table" then
					if data.name and type(data.name) == "string" then
						targetTable[data.name] = data
					else
						for key, value in pairs(data) do
							targetTable[key] = value
						end
					end
				else
					warn(string.format("[Library.Directory] Falha ao carregar ModuleScript '%s': %s", child:GetFullName(), tostring(data)))
				end
			elseif child:IsA("Folder") then
				LoadModulesRecursively(child, targetTable)
			end
		end
	end

	for _, categoryFolder in ipairs(directoryFolder:GetChildren()) do
		if categoryFolder:IsA("Folder") then
			local categoryName = categoryFolder.Name
			Library.Directory[categoryName] = Library.Directory[categoryName] or {}
			LoadModulesRecursively(categoryFolder, Library.Directory[categoryName])
		end
	end
end


-- Integracao com camadas especificas do Servidor ou Cliente via __index
if isServer then
	local ServerScriptService = game:GetService("ServerScriptService")
	local serverLibraryFolder = ServerScriptService:WaitForChild("Library", 10)
	if serverLibraryFolder and serverLibraryFolder:FindFirstChild("init") then
		local serverInit = require(serverLibraryFolder:FindFirstChild("init") :: ModuleScript)
		setmetatable(Library, { __index = serverInit })
	elseif serverLibraryFolder and serverLibraryFolder:IsA("ModuleScript") then
		local serverInit = require(serverLibraryFolder)
		setmetatable(Library, { __index = serverInit })
	end
else
	local clientFolder = ReplicatedStorage:WaitForChild("Library", 10) or ReplicatedStorage:WaitForChild("Libray", 10)
	if clientFolder and clientFolder:FindFirstChild("Client") then
		local clientInit = require(clientFolder:FindFirstChild("Client") :: ModuleScript)
		setmetatable(Library, { __index = clientInit })
	end
end

Library.Loaded = true
return Library

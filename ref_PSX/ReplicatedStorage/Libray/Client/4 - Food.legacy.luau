function Food.new(id, customerOwnerUID, customerOwnerID, customerWasRich, isNearTree)
	
	local self = setmetatable({}, {__index = Food})
	
	self.ID = id
	self.UID = _L.Functions.GenerateUID()
	self.customerOwnerUID = customerOwnerUID
	self.customerOwnerID = customerOwnerID
	self.customerWasRich = customerWasRich
	self.data = _L.Directory.Food[id]
	self.clickDetector = nil
	self.model = nil
	self.moneyModel = nil
	self.moneyPickedUp = false
	self.flaggedDishwasherUID = nil
	self.isNearTree = isNearTree or false
	
	-- list item shown in popup UI
	self.popupListItemUI = nil
	
	return self
	
end

function Food.RandomFoodChoice(customerOwnerUID, customerOwnerID, isRichCustomer, isPirateCustomer, isNearTree)
	local foodID = tostring(Food.OwnedRecipes[math.random(#Food.OwnedRecipes)])
	
	if isPirateCustomer then
		foodID = "45"
	else
		
		-- if VIP customer, order most expensive thing on the list
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "13" then
			local bestID = nil
			local bestPrice = nil
			for _, searchFoodID in ipairs(Food.OwnedRecipes) do
				local foodCost = _L.Directory.Food[searchFoodID].baseCashAward
				if not bestID or foodCost > bestPrice then
					bestID = searchFoodID
					bestPrice = _L.Directory.Food[searchFoodID].baseCashAward
				end
			end
			if bestID then
				foodID = bestID
			end
		end
		
		-- if John Doe, order hacked lobster
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "29" then
				foodID = "47"
		end
		
		-- if princess, order spaghetti
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "34" then
			foodID = "5"
		end
		
		-- if alien, order spaghetti
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "32" then
			foodID = "5"
		end
		-- if lifeguard, order spaghetti
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "33" then
			foodID = "5"
		end
		-- if Dark Matter, order most expensive thing on the list
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "30" then
			foodID = "48"
		end
		
		-- if Preston, order robux
		local customerOwner = _L.Variables.MyBakery:GetEntityByUID(customerOwnerUID)
		if customerOwner and customerOwner.ID == "31" then
			foodID = "49"
		end
		
		-- gingerbread chance if snowman
		local snowman = _L.Variables.MyBakery.nameCounters["Snowman"] or 0
		if snowman > 0 and math.random() < 0.05 then
			foodID = "46"
		end
	end
	
	return Food.new(foodID, customerOwnerUID, customerOwnerID, isRichCustomer, isNearTree)
end

function Food.LoadOwnedRecipes()
	Food.OwnedRecipes = _L.Network.Invoke("GetOwnedRecipes")
	_L.Signal.Fire("RefreshRecipeUI")
end
_L.Network.Fired("BakeryLevelUp"):Connect(Food.LoadOwnedRecipes)
_L.Network.Fired("RefreshOwnedRecipes"):Connect(Food.LoadOwnedRecipes)

function Food:MakePopupListItemUICook(parentContainer)
	
	self.popupListItemUI = _L.CustomUIEffects.MakeOrderStandListItemCook(parentContainer, self)
	self.popupListItemUI.ZIndex = 5
	
	return self.popupListItemUI
	
end

function Food:MakePopupListItemUIServe(parentContainer)
	
	self.popupListItemUI = _L.CustomUIEffects.MakeOrderStandListItemServe(parentContainer, self)
	self.popupListItemUI.ZIndex = 5
	
	return self.popupListItemUI
	
end

function Food:DestroyPopupListItemUI()
	if not self.popupListItemUI then
		return
	end
	
	self.pooupListItemUI = self.popupListItemUI:Destroy()

end

function Food:MakeModel()
	
	if self.model then
		self.model:Destroy()
	end
	
	self.model = self.data.model:Clone()
	self.model.Parent = _L.Variables.MyBakery.container.Food
	
	if self.isGold then
		for _, child in ipairs(self.model:GetDescendants()) do
			if child:IsA("MeshPart") then
				child.TextureID = ""
				child.Reflectance = 0.20
				child.BrickColor = BrickColor.new("Gold")
			end
		end
		game.ReplicatedStorage.Assets.Particles.GoldenFoodSparkles:Clone().Parent = self.model.PrimaryPart
	end
	
end

function Food:ChangeToDirtyDish()
	
	if not self.model then
		return
	end
	
	local oldParent = self.model.Parent
	local dirtyDish = game.ReplicatedStorage.Assets.BakeryEntityAssets.Food.DirtyDish:Clone()
	local myModelPosition = self.model.PrimaryPart.Position
	local heightDifference = self.model.PrimaryPart.Size.Y - dirtyDish.PrimaryPart.Size.Y
	
	dirtyDish.PrimaryPart.Position = myModelPosition - Vector3.new(0, heightDifference/2, 0)
	self.model:Destroy()
	self.model = dirtyDish
	self.model.Parent = oldParent

	
end

function Food:SetModelPrimaryPartCFrame(worldCFrame)
	self.model:SetPrimaryPartCFrame(worldCFrame)
end

function Food:DestroyModel()
	
	if self.model then
		self.model = self.model:Destroy()
	end
end

function Food:CreateMoneyClickDetector(callback)
	if self.moneyClickDetector or not self.moneyModel then
		return
	end
	
	self.moneyClickDetector = Instance.new("ClickDetector")
	self.moneyClickDetector.MaxActivationDistance = 14
	self.moneyClickDetector.Parent = self.moneyModel.PrimaryPart
	self.moneyClickDetector.MouseClick:Connect(function()
		if callback then
			callback()
		end
	end)
end

-- @classmethod
function Food:Interact(callback)
	local INTERACT_DISTANCE = 9
	local interactEvent, destroyer = _L.Interact.Add(self.model.PrimaryPart, INTERACT_DISTANCE)
	interactEvent:Connect(function()
		callback(destroyer)
	end)
	self.interactEvent = interactEvent
	self.interactDestroyer = destroyer
	
	if self.emoji then
		if self.emojiInteract then
			self.emojiInteract:Disconnect()
		end
		self.emojiInteract = self.emoji.Frame.MouseButton1Click:Connect(function()
			callback(destroyer)
		end)
	end
end

-- @classmethod
function Food:CleanupInteract()
	if not self.interactEvent then
		return
	end
	self.interactDestroyer()
	self.interactEvent = nil
	self.interactDestroyer = nil
	
	if self.emojiInteract then
		self.emojiInteract:Disconnect()
		self.emojiInteract = nil
	end
end

function Food:InitMoneyModel(moneyAngle, isMoneyBag)
	local moneyPart
	local heightOffset = 0
	if isMoneyBag then
		moneyPart = game.ReplicatedStorage.Assets.Models.MoneyBag:Clone()
		heightOffset = 0.80
	else
		moneyPart = game.ReplicatedStorage.Assets.Models.MoneyStack:Clone()
	end
	self.moneyModel = moneyPart
	self.moneyPickedUp = false
	self.moneyModel.Parent = self.model.Parent
	self.moneyModel:SetPrimaryPartCFrame(CFrame.new(self.model:GetPrimaryPartCFrame().p) * CFrame.Angles(0, moneyAngle, 0) * CFrame.new(0, heightOffset, 1.5))
end

function Food:MoneyPickedUp()
	
	if self.moneyPickedUp or not self.moneyModel then
		return
	end
	local moneyModelPosition = self.moneyModel.PrimaryPart.Position
	local moneyModelName = self.moneyModel.Name
	self.moneyModel = self.moneyModel:Destroy()
	self.moneyPickedUp = true
	
	local customerOwner = _L.Variables.MyBakery:GetEntityByUID(self.customerOwnerUID)
	local customerFoodTable = {
		[self.customerOwnerUID] = self.ID
	}
	
	_L.Network.Fire("AwardFoodCashWithVerification", customerFoodTable, self.isGold)
	
	-- money picked up sound
	if moneyModelName == "MoneyBag" then
		_L.SFX.Play(5226914991, moneyModelPosition, nil, 0.50)
	else
		_L.SFX.Play(5057745518, moneyModelPosition)
	end
	
	-- tutorial event
	if _L.Variables.MyBakery.isTutorial then
		_L.Signal.Fire("Tutorial_CashPickedUp")
	end
	
	-- money particle
	local host = _L.Functions.CreateParticleHost(moneyModelPosition)
	local particles = {
		game.ReplicatedStorage.Assets.Particles.CashCollect.ParticleEmitterGreen:Clone(),
		game.ReplicatedStorage.Assets.Particles.CashCollect.ParticleEmitterWhite:Clone()
	}
	for _, particle in ipairs(particles) do
		local amount = math.random(3, 5)
		particle.Parent = host
		particle:Emit(amount)
	end
	coroutine.wrap(function()
		wait(2)
		host:Destroy()
	end)()
	
	-- boost active?
	local award = math.floor(_L.Directory.Food[self.ID].baseCashAward + 0.50)
	if _L.TimedProduct.BoostIsActive("Double Cash") then
		award *= 2
	end
	
	-- vip customer or rich customer?
	if self.customerOwnerID == "13" then
		award *= 10
	elseif self.customerOwnerID == "26" then
		award *= 60
	elseif self.customerOwnerID == "25" then
		award *= 66666
	elseif self.customerOwnerID == "22" then
		award *= 50
	elseif self.customerOwnerID == "23" or self.customerOwnerID == "24" then
		award *= 10
	elseif self.customerOwnerID == "14" then
		award *= 50000
	elseif self.customerOwnerID == "15" or self.customerOwnerID == "20" then
		award *= 5
	elseif self.customerOwnerID == "33" then
		award *= 25
	elseif self.customerOwnerID == "32" then
		award *= 50 
	elseif self.customerOwnerID == "34" then
		award *= 1337
	elseif self.customerWasRich then
		award *= 2.5
	elseif self.customerOwnerID == "27" then
		award *= 40
	end
	if self.isGold then
		award *= 3.0
	end
	if self.isNearTree then
		award *= 2
	end
	
	_L.CustomUIEffects.CreateRewardBillboard(moneyModelPosition + Vector3.new(0, 1.25, 0), award)
end

function Food:DestroyClickDetector()
	if self.clickDetector then
		self.clickDetector = self.clickDetector:Destroy()
	end
end

return Food
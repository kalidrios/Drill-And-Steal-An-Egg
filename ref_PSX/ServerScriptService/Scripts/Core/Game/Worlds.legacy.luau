-- VALENTINE BROADCAST (VDayGram)
--------------------------------------------------------------------------------------------------------
local VDAY_MESSAGES = {
	"I'll love you until the day you die 💕",
	"You're the brainrot to my Italian 🧠",
	"Be my Valentine? 💌",
	"You make my heart go brrr 💗",
	"I'd trade my rarest pet for you 🐾",
	"You're more legendary than a Mythic! ✨"
}

local TextService = game:GetService("TextService")
local vdayGramCooldowns = {}

_L.Network.Invoked("Send VDayGram").OnInvoke = function(plyr, recipientName, messageIndex)
	local save = _L.Saving.Get(plyr)
	if not save then
		return false, "No save data."
	end

	-- Validate credits
	local credits = save.VDayGramCredits or 0
	if credits <= 0 then
		return false, "You don't have any VDayGram credits! Buy one from the Exclusive Shop."
	end

	-- Cooldown (5 seconds)
	if vdayGramCooldowns[plyr] and os.clock() - vdayGramCooldowns[plyr] < 5 then
		return false, "Please wait before sending another."
	end

	-- Validate message index
	if type(messageIndex) ~= "number" or messageIndex < 1 or messageIndex > #VDAY_MESSAGES then
		return false, "Invalid message."
	end

	-- Validate recipient name
	if type(recipientName) ~= "string" or #recipientName < 1 or #recipientName > 20 then
		return false, "Invalid username."
	end

	-- Filter recipient name
	local filterSuccess, filteredName = pcall(function()
		local result = TextService:FilterStringAsync(recipientName, plyr.UserId)
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not filterSuccess then
		filteredName = recipientName
	end

	-- Consume credit
	save.VDayGramCredits = credits - 1
	vdayGramCooldowns[plyr] = os.clock()

	-- Broadcast to all servers
	local msg = "💕 " .. plyr.Name .. " sent " .. filteredName .. " a Valentine: " .. VDAY_MESSAGES[messageIndex]
	local broadcastSuccess = pcall(function()
		_L.MessagingService:PublishAsync("Global: Message", {
			msg = msg,
			player = {Name = plyr.Name}
		})
	end)

	if not broadcastSuccess then
		-- Refund credit if broadcast failed
		save.VDayGramCredits = save.VDayGramCredits + 1
		return false, "Failed to send. Try again!"
	end

	return true, "💕 VDayGram sent!"
end

-- Cleanup VDayGram cooldown when player leaves
game.Players.PlayerRemoving:Connect(function(plyr)
	vdayGramCooldowns[plyr] = nil
end)


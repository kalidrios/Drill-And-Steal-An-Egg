-- UGC VAULT: Buy gate + Secure teleport with MemoryStore handshake
--------------------------------------------------------------------------------------------------------
_L.Network.Invoked("Buy UGC Gate").OnInvoke = function(plyr)
	local save = _L.Saving.Get(plyr)
	if not save then
		return
	end

	if save.OwnsUGCVault then
		return false, "already owned"
	end

	-- Anti-cheat: cheaters without Cave area pay more and get rejected
	local hasCave = _L.Worlds.HasArea(plyr, "Cave")
	local cost = hasCave and 100 or 180
	local tokens = save["Paw Tokens"] or 0

	if tokens >= cost then
		-- TROLL: Player has enough tokens but doesn't have Cave area
		if not hasCave then
			return false, "⚠️ You need to unlock Cave area first!"
		end

		-- Legitimate purchase
		save.OwnsUGCVault = true
		save["Paw Tokens"] = tokens - cost

		return true
	else
		return false, "You need " .. _L.Functions.Commas(cost - tokens) .. " more Paw Tokens!"
	end
end

_L.Network.Invoked("Travel to UGC Vault").OnInvoke = function(plyr)
	local save = _L.Saving.Get(plyr)
	if not save then
		return nil, "Failed to get save."
	end

	if not save.OwnsUGCVault then
		return false, "UGC Vault isn't unlocked?"
	end

	-- Debounce: prevent spam
	if ugcVaultCooldowns[plyr] and os.clock() - ugcVaultCooldowns[plyr] < 10 then
		return false, "Please wait before trying again."
	end
	ugcVaultCooldowns[plyr] = os.clock()

	-- Generate handshake token and store in MemoryStore
	local token = HttpService:GenerateGUID(false)
	local success = pcall(function()
		UGCHandshake:SetAsync(tostring(plyr.UserId), token, 120) -- 2 min TTL
	end)

	if not success then
		return false, "Server error. Try again."
	end

	return pcall(function()
		_L.TeleportService:Teleport(UGC_VAULT_PLACE_ID, plyr)
	end)
end


	wait(2)

	coroutine.wrap(function()
		if _L.Shared.IsHardcore then
			_G.HasLoaded(plyr) task.delay(1, function()
				_L.Network.Fire("Chat Msg", plyr, "Welcome to Hardcore Mode!", Color3.fromRGB(176,100,254))
			end)
		end	
	end)()

	if _L.RunService:IsStudio() then
		return
	end

	local isPlaza = _L.Shared.IsTradingPlaza
	local isHardcore = _L.Shared.IsHardcore

	local save = _L.Saving.Get(plyr)
	if save  then
		if isHardcore and not save.HardcoreUnlocked then
			plyr:Kick("Please rejoin.")
		end
		if isPlaza and not save.OwnsTradingPlaza then
			plyr:Kick("Please rejoin.")
		end
		-- UGC Vault: validate MemoryStore token
		if _L.Shared.IsUGCVault then
			-- Studio Bypass
			if _L.RunService:IsStudio() then
				warn("UGC VAULT: Running in Studio, bypassing token check.")
				task.delay(3, function()
					if plyr and plyr.Parent then
						MarketplaceService:PromptPurchase(plyr, UGC_ASSET_ID)
					end
				end)
				return
			end

			local userId = tostring(plyr.UserId)
			local tokenSuccess, token = pcall(function()
				return UGCHandshake:GetAsync(userId)
			end)
			if tokenSuccess and token then
				-- Consume token immediately (prevents replay attacks)
				pcall(function()
					UGCHandshake:RemoveAsync(userId)
				end)
				-- PromptPurchase from SERVER (secure: requires PurchaseAuthToken)
				task.delay(3, function()
					if plyr and plyr.Parent then
						MarketplaceService:PromptPurchase(plyr, UGC_ASSET_ID)
					end
				end)
			else
				plyr:Kick("Complete the quest first.")
			end
		end
	end
end)

